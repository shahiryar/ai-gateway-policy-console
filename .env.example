# Local development. Copy to .env and export, or set in your shell.

# Demo mode: simulated Model Armor and DLP, no Google credentials needed.
GOOGLE_API_MODE=mock

# Live mode against a real project, using your own gcloud identity instead of OAuth:
# GOOGLE_API_MODE=live
# GCP_PROJECT_ID=my-project
# MODEL_ARMOR_LOCATIONS=us-central1
# DEV_ACCESS_TOKEN=$(gcloud auth print-access-token)
# DEV_USER_EMAIL=you@example.com
# STORE=memory
